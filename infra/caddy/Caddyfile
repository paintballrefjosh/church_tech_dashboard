{
	# HTTPS is offloaded by the upstream load balancer.
	# We listen plain HTTP on :8100 only; no auto-TLS.
	auto_https off

	# Which peers may set X-Forwarded-For / -Proto / -Host. TRUSTED_PROXIES is a
	# space-separated list of CIDRs: set it to your load balancer's addresses so the
	# client IP in the audit log and the rate limits is the real one and cannot be
	# spoofed with a forged header. When it is set, compose also turns on
	# `trusted_proxies_strict` (TRUSTED_PROXIES_STRICT), which reads the header right
	# to left and takes the first address that is not a trusted proxy, so entries a
	# client adds on the left are never believed.
	#
	# Unset, the default trusts every peer and takes the leftmost entry, as before:
	# fine only when something upstream already overwrites X-Forwarded-For (a client
	# can otherwise choose the IP that is logged). Strict mode is not on by default
	# because with everything trusted it would report the proxy's own address for
	# every user.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
		{$TRUSTED_PROXIES_STRICT:}
	}

	log default {
		output stdout
		format console
		level INFO
	}
}

:8100 {
	encode gzip zstd

	# Baseline security headers, applied to every response. Each:
	#   X-Content-Type-Options nosniff — keeps browsers from MIME-sniffing
	#     past the declared content-type (already set per-route on attachment
	#     downloads, but defence-in-depth for everything else).
	#   X-Frame-Options DENY — kills clickjacking. We never embed this site
	#     in an iframe, including from itself.
	#   Referrer-Policy strict-origin-when-cross-origin — leaks only the
	#     origin (not the path) when navigating to external links.
	#   Permissions-Policy — disable browser features we never use.
	#   Content-Security-Policy — restrict scripts/styles to self + the
	#     Socket.IO endpoint we serve from the same origin. img-src is wider
	#     to allow OAuth-provided avatars (Google/Microsoft) and inline
	#     data: URIs that Next emits for the dev experience.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# HSTS deliberately omitted — HTTPS termination is upstream of Caddy
		# (per CLAUDE.md), so it's the LB's job to set HSTS.
	}

	# We pass the *original* Host header through to every upstream so Auth.js
	# (trustHost: true) and any other URL-building code reconstruct the public
	# origin from the hostname the user actually typed — localhost, a LAN IP,
	# docker01.example.com, an upstream HTTPS LB, whatever — without any
	# value baked into env or code.
	#
	# Caddy v2's default is to rewrite Host to the upstream address (e.g.
	# web:3000). The `header_up Host {host}` lines below override that so the
	# upstream sees the same Host the client sent.

	# Load balancer health check. 200 only while this node's API can reach the
	# database (the API's readiness answers 503 otherwise, and a dead API gives
	# 502). It answers 503 "draining" while the flag file data/caddy/drain exists
	# (`scripts/cluster.sh drain`), so a node can be taken out of rotation before
	# an upgrade without touching the load balancer. The node name is returned in
	# a header to make a check easy to attribute.
	handle /healthz {
		header X-Church-Node "{$NODE_ID:unknown}"
		@draining file {
			root /data
			try_files drain
		}
		respond @draining "draining" 503
		rewrite * /api/v1/readyz
		reverse_proxy api:3001 {
			header_up Host {host}
		}
	}

	# Internal-only endpoints that hand out secrets (OAuth client_id/secret) or
	# accept un-authenticated state mutations. The web container reaches these
	# directly via api:3001 on the docker bridge — they have no business being
	# reachable from the public proxy. Defence-in-depth alongside the
	# X-Internal-Token check on the controller side.
	@internal_only path /api/v1/auth/providers/internal* /api/v1/users/ensure-default-group*
	handle @internal_only {
		respond "Not found" 404
	}

	handle /api/v1/* {
		reverse_proxy api:3001 {
			header_up Host {host}
			# Clobber X-Forwarded-For with the client's real IP. Without this,
			# a malicious client can spoof XFF at the edge and have the api
			# log a chosen IP in audit_log. (If an HTTPS LB is upstream of
			# Caddy and itself sets a trustworthy XFF, point Caddy at it
			# via `trusted_proxies` and remove this override.)
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /socket.io/* {
		reverse_proxy api:3001 {
			header_up Host {host}
			# Clobber X-Forwarded-For with the client's real IP. Without this,
			# a malicious client can spoof XFF at the edge and have the api
			# log a chosen IP in audit_log. (If an HTTPS LB is upstream of
			# Caddy and itself sets a trustworthy XFF, point Caddy at it
			# via `trusted_proxies` and remove this override.)
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {client_ip}
		}
	}
}
