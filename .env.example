# ---- Public ----
APP_URL=http://localhost:8100
# Auth.js v5 uses AUTH_URL to construct OAuth redirect URIs and sign-in callbacks.
# Keep it equal to APP_URL unless you're doing something custom.
AUTH_URL=http://localhost:8100
# Host ports — change if any conflict with other projects on the same host.
# `make check-ports` warns about collisions before `make up`.
EXTERNAL_PORT=8100         # public proxy (the only port real users need)
COCKROACH_UI_PORT=8180     # dev: Cockroach admin UI
MAILHOG_UI_PORT=18025      # dev: MailHog inbox viewer
NODE_ENV=development

# ---- Auth ----
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-openssl-rand-hex-32
# If true, Credentials provider is disabled and only Google OAuth is allowed
AUTH_DISABLE_LOCAL=false
# TOTP is required for admin role regardless; this forces it for everyone
AUTH_REQUIRE_TOTP_ALL=false

# ---- Google OAuth (optional in dev) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Restrict Google sign-in to a single Workspace domain (recommended)
GOOGLE_WORKSPACE_DOMAIN=

# ---- Google Workspace Admin SDK (for Groups sync) ----
# Path INSIDE the api container. Default mount: ./secrets/google-sa.json -> /run/secrets/google-sa.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADMIN_IMPERSONATE=

# ---- Database ----
# In-stack default; override only if pointing at an external Cockroach cluster
COCKROACH_URL=postgresql://root@cockroach-1:26257/church?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MinIO (S3-compatible) ----
MINIO_ENDPOINT=minio:9000
MINIO_REGION=us-east-1
MINIO_ROOT_USER=churchadmin
MINIO_ROOT_PASSWORD=change-me-please
MINIO_BUCKET=church-files
MINIO_USE_SSL=false

# ---- Meilisearch ----
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=dev-master-key-change-in-prod

# ---- SMTP ----
# Dev: MailHog is started automatically and is used if SMTP_HOST is mailhog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Church Dashboard <noreply@church.local>
SMTP_SECURE=false

# ---- Bootstrap admin ----
# Seed always creates user "admin" with password "admin" and forces a password
# change on first login. Nothing to set here. Use `make reset-admin` to reset it.

# ---- Internal (do not change unless you know what you're doing) ----
API_INTERNAL_URL=http://api:3001
WEB_INTERNAL_URL=http://web:3000
