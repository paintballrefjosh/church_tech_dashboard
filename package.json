{
  "name": "church-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:up": "bash scripts/compose.sh up -d --build",
    "dev:down": "bash scripts/compose.sh down",
    "dev:logs": "bash scripts/compose.sh logs -f --tail=200",
    "dev:psql": "make psql",
    "prod:up": "bash scripts/compose.sh --prod up -d --build",
    "prod:down": "bash scripts/compose.sh --prod down",
    "db:generate": "pnpm --filter @church/api db:generate",
    "db:migrate": "pnpm --filter @church/api db:migrate",
    "db:seed": "pnpm --filter @church/api db:seed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=!@church/e2e",
    "test:smoke": "node tests/smoke/run.mjs",
    "test:e2e": "pnpm --filter @church/e2e test",
    "regression": "node tests/smoke/run.mjs && pnpm --filter @church/e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@^3": "3.1.8",
      "fast-uri@^2": "2.4.7",
      "proxy-addr@^2": "2.0.8",
      "ip-address@^10": "10.7.4",
      "fast-copy@^3": "3.1.0",
      "fast-xml-parser@^4": "4.5.7",
      "engine.io@^6": "6.6.11",
      "ws@^8": "8.22.0",
      "socket.io-parser@^4": "4.2.7",
      "prosemirror-view@^1": "1.42.6",
      "markdown-it@^14": "14.3.2",
      "linkify-it@^5": "5.0.2",
      "postcss@^8": "8.5.29",
      "nanoid@^3": "3.3.20",
      "source-map-js@^1": "1.2.2",
      "cookie@^0": "0.7.2",
      "@types/node": "20.16.10",
      "@fastify/busboy@^3": "3.2.3"
    },
    "patchedDependencies": {
      "@fastify/busboy@3.2.3": "patches/@fastify__busboy@3.2.3.patch",
      "drizzle-orm@0.45.4": "patches/drizzle-orm@0.45.4.patch"
    }
  }
}
