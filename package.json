{
  "name": "church-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:up": "bash scripts/compose.sh up -d --build",
    "dev:down": "bash scripts/compose.sh down",
    "dev:logs": "bash scripts/compose.sh logs -f --tail=200",
    "dev:psql": "make psql",
    "prod:up": "bash scripts/compose.sh --prod up -d --build",
    "prod:down": "bash scripts/compose.sh --prod down",
    "db:generate": "pnpm --filter @church/api db:generate",
    "db:migrate": "pnpm --filter @church/api db:migrate",
    "db:seed": "pnpm --filter @church/api db:seed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=!@church/e2e",
    "test:smoke": "node tests/smoke/run.mjs",
    "test:e2e": "pnpm --filter @church/e2e test",
    "regression": "node tests/smoke/run.mjs && pnpm --filter @church/e2e test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.2"
  }
}
